{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satellite-drawings.invalid/contracts/operation.schema.json",
  "$ref": "#/$defs/OperationEnvelope",
  "$defs": {
    "OperationEnvelope": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "module": {
          "enum": [
            "paint",
            "blanket"
          ]
        },
        "operation": {
          "enum": [
            "paint.generate",
            "paint.recommend",
            "paint.generate_batch",
            "paint.edit_regions",
            "blanket.detect_installation",
            "blanket.generate",
            "blanket.edit_shape",
            "blanket.unfold",
            "blanket.edit_seams",
            "blanket.edit_fixed_points",
            "drawing.edit_annotation",
            "drawing.export",
            "engineering.save",
            "engineering.restore",
            "history.undo",
            "history.redo",
            "geometry.analyze",
            "engineering.rebind"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "model_ref": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1
            },
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "model_revision": {
              "type": "integer",
              "minimum": 1
            },
            "assembly_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "project_id",
            "model_id",
            "model_revision",
            "assembly_digest"
          ],
          "additionalProperties": false
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1
        },
        "selection_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "model_revision": {
                "type": "integer",
                "minimum": 1
              },
              "assembly_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "instance_id": {
                "type": "string",
                "minLength": 1
              },
              "entity_kind": {
                "enum": [
                  "face",
                  "edge",
                  "vertex",
                  "solid",
                  "instance"
                ]
              },
              "entity_id": {
                "type": "string",
                "minLength": 1
              },
              "signature": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "area_mm2": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "centroid_mm": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "normal": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "adjacency": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "type",
                  "area_mm2",
                  "centroid_mm",
                  "normal",
                  "adjacency"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "project_id",
              "model_id",
              "model_revision",
              "assembly_digest",
              "instance_id",
              "entity_kind",
              "entity_id",
              "signature"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "parameters": {
          "type": "object"
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "schema_version",
        "module",
        "operation",
        "project_id",
        "model_ref",
        "expected_revision",
        "selection_refs",
        "parameters",
        "overrides",
        "idempotency_key"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "operation": {
                "pattern": "^paint\\."
              }
            }
          },
          "then": {
            "properties": {
              "module": {
                "const": "paint"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "blanket.detect_installation"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {
                  "target_instances": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1},
                    "minItems": 1,
                    "uniqueItems": true
                  },
                  "excluded_instances": {
                    "type": "array",
                    "items": {"type": "string", "minLength": 1},
                    "minItems": 0,
                    "uniqueItems": true
                  },
                  "maximum_gap_mm": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 0.1
                  }
                },
                "required": ["target_instances", "excluded_instances", "maximum_gap_mm"],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "pattern": "^blanket\\."
              }
            }
          },
          "then": {
            "properties": {
              "module": {
                "const": "blanket"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "paint.generate"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "paint.schema.json#/$defs/PaintInput"
              }
            }
          }
        },
        {
          "if": {"properties": {"operation": {"const": "paint.recommend"}}},
          "then": {"properties": {"parameters": {"$ref": "paint.schema.json#/$defs/PaintRecommendationInput"}}}
        },
        {
          "if": {"properties": {"operation": {"const": "paint.generate_batch"}}},
          "then": {
            "properties": {
              "parameters": {"$ref": "paint.schema.json#/$defs/PaintBatchInput"},
              "overrides": {"type": "array", "items": {"$ref": "paint.schema.json#/$defs/PaintOverride"}, "uniqueItems": true, "x-uniqueBy": "id"}
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "blanket.generate"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "blanket.schema.json#/$defs/BlanketInput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "paint.generate"
              }
            }
          },
          "then": {
            "properties": {
              "overrides": {
                "type": "array",
                "items": {
                  "$ref": "paint.schema.json#/$defs/PaintOverride"
                },
                "uniqueItems": true,
                "x-uniqueBy": "id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "paint.edit_regions"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "result_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "action": {
                        "enum": [
                          "add",
                          "exclude"
                        ]
                      },
                      "points": {
                        "type": "array",
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "number",
                            "minimum": -10000000.0,
                            "maximum": 10000000.0
                          },
                          "minItems": 2,
                          "maxItems": 2
                        },
                        "minItems": 3,
                        "maxItems": 512
                      }
                    },
                    "required": [
                      "result_id",
                      "reason",
                      "action",
                      "points"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "result_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 500
                      },
                      "action": {
                        "const": "move"
                      },
                      "region_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "delta_mm": {
                        "type": "array",
                        "items": {
                          "type": "number",
                          "minimum": -10000000.0,
                          "maximum": 10000000.0
                        },
                        "minItems": 2,
                        "maxItems": 2
                      }
                    },
                    "required": [
                      "result_id",
                      "reason",
                      "action",
                      "region_id",
                      "delta_mm"
                    ],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "drawing.edit_annotation"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {
                  "result_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "annotation_id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "position": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": -10000000.0,
                      "maximum": 10000000.0
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "result_id",
                  "annotation_id",
                  "text",
                  "position"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "drawing.export"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {"result_id": {"type": "string", "minLength": 1}, "draft": {"const": true}, "preview": {"type": "boolean"}},
                    "required": ["result_id", "draft"],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {"batch_result_id": {"type": "string", "minLength": 1}, "draft": {"const": true}},
                    "required": ["batch_result_id", "draft"],
                    "additionalProperties": false
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "history.undo"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "history.redo"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "blanket.edit_shape"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "blanket.schema.json#/$defs/EditShape"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "blanket.unfold"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "blanket.schema.json#/$defs/Unfold"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "blanket.edit_seams"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "blanket.schema.json#/$defs/EditSeams"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "blanket.edit_fixed_points"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "blanket.schema.json#/$defs/EditFixedPoints"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "geometry.analyze"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "complex.schema.json#/$defs/AnalysisInput"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "const": "engineering.rebind"
              }
            }
          },
          "then": {
            "properties": {
              "parameters": {
                "$ref": "complex.schema.json#/$defs/RebindInput"
              }
            }
          }
        }
      ]
    },
    "SelectionContext": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "enum": [
            "paint",
            "blanket"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "model_ref": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "minLength": 1
            },
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "model_revision": {
              "type": "integer",
              "minimum": 1
            },
            "assembly_digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "project_id",
            "model_id",
            "model_revision",
            "assembly_digest"
          ],
          "additionalProperties": false
        },
        "engineering_revision": {
          "type": "string",
          "minLength": 1
        },
        "result_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "entity_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "project_id": {
                "type": "string",
                "minLength": 1
              },
              "model_id": {
                "type": "string",
                "minLength": 1
              },
              "model_revision": {
                "type": "integer",
                "minimum": 1
              },
              "assembly_digest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "instance_id": {
                "type": "string",
                "minLength": 1
              },
              "entity_kind": {
                "enum": [
                  "face",
                  "edge",
                  "vertex",
                  "solid",
                  "instance"
                ]
              },
              "entity_id": {
                "type": "string",
                "minLength": 1
              },
              "signature": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "minLength": 1
                  },
                  "area_mm2": {
                    "anyOf": [
                      {
                        "type": "number",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "centroid_mm": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "normal": {
                    "anyOf": [
                      {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "adjacency": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0
                  }
                },
                "required": [
                  "type",
                  "area_mm2",
                  "centroid_mm",
                  "normal",
                  "adjacency"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "project_id",
              "model_id",
              "model_revision",
              "assembly_digest",
              "instance_id",
              "entity_kind",
              "entity_id",
              "signature"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "view": {
          "enum": [
            "3d",
            "2d"
          ]
        },
        "local_coordinates": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 2,
                "maxItems": 3
              },
              "maxItems": 512
            }
          ]
        },
        "annotation": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "view_transform": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/Transform"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 16,
              "maxItems": 16
            }
          ]
        },
        "blanket_target": {
          "$ref": "#/$defs/BlanketSelectionTarget"
        }
      },
      "required": [
        "schema_version",
        "session_id",
        "module",
        "project_id",
        "model_ref",
        "engineering_revision",
        "result_id",
        "entity_refs",
        "view",
        "local_coordinates",
        "annotation",
        "view_transform"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "blanket_target"
            ]
          },
          "then": {
            "properties": {
              "module": {
                "const": "blanket"
              }
            }
          }
        }
      ]
    },
    "SessionBinding": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "module": {
          "enum": [
            "paint",
            "blanket"
          ]
        },
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "expected_revision": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "session_id",
        "module",
        "project_id",
        "expected_revision"
      ],
      "additionalProperties": false
    },
    "BlanketSelectionTarget": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "seam"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "edges": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "panel_key": {
                    "type": "string",
                    "minLength": 1
                  },
                  "panel_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mapping_ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "world": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "number"
                      },
                      "minItems": 3,
                      "maxItems": 3
                    },
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "required": [
                  "id",
                  "panel_key",
                  "panel_id",
                  "mapping_ref",
                  "world"
                ],
                "additionalProperties": false
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "kind",
            "id",
            "edges"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "point"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "panel_key": {
              "type": "string",
              "minLength": 1
            },
            "panel_id": {
              "type": "string",
              "minLength": 1
            },
            "mapping_ref": {
              "type": "string",
              "minLength": 1
            },
            "uv_mm": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            },
            "position3d": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "kind",
            "id",
            "panel_key",
            "panel_id",
            "mapping_ref",
            "uv_mm",
            "position3d"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
