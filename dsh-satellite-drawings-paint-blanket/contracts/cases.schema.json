{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satellite-drawings.invalid/contracts/cases.schema.json",
  "$ref": "#/$defs/CaseManifest",
  "$defs": {
    "CaseManifest": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "cases": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "module": {
                "enum": [
                  "paint",
                  "blanket",
                  "shared"
                ]
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "split": {
                "enum": [
                  "development",
                  "holdout"
                ]
              },
              "source_manifest": {
                "type": "string",
                "minLength": 1
              },
              "main_file": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "vendor": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "version": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expected_instances": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reference_artifacts": {
                "anyOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "revision_match_status": {
                "enum": [
                  "unknown",
                  "matched",
                  "mismatch"
                ]
              },
              "selection_spec": {
                "anyOf": [
                  {
                    "type": "object",
                    "minProperties": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "expected_checks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "tolerances": {
                "anyOf": [
                  {
                    "type": "object",
                    "minProperties": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "requires_tools": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "unknown_reasons": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "completeness": {
                "enum": [
                  "not_opened",
                  "complete",
                  "partial",
                  "failed"
                ]
              }
            },
            "required": [
              "id",
              "module",
              "purpose",
              "split",
              "source_manifest",
              "main_file",
              "vendor",
              "version",
              "expected_instances",
              "reference_artifacts",
              "revision_match_status",
              "selection_spec",
              "expected_checks",
              "tolerances",
              "requires_tools",
              "unknown_reasons",
              "completeness"
            ],
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "main_file": {
                      "const": null
                    }
                  }
                },
                "then": {
                  "properties": {
                    "unknown_reasons": {
                      "required": [
                        "main_file"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "vendor": {
                      "const": null
                    }
                  }
                },
                "then": {
                  "properties": {
                    "unknown_reasons": {
                      "required": [
                        "vendor"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "version": {
                      "const": null
                    }
                  }
                },
                "then": {
                  "properties": {
                    "unknown_reasons": {
                      "required": [
                        "version"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "expected_instances": {
                      "const": null
                    }
                  }
                },
                "then": {
                  "properties": {
                    "unknown_reasons": {
                      "required": [
                        "expected_instances"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "reference_artifacts": {
                      "const": null
                    }
                  }
                },
                "then": {
                  "properties": {
                    "unknown_reasons": {
                      "required": [
                        "reference_artifacts"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "selection_spec": {
                      "const": null
                    }
                  }
                },
                "then": {
                  "properties": {
                    "unknown_reasons": {
                      "required": [
                        "selection_spec"
                      ]
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "tolerances": {
                      "const": null
                    }
                  }
                },
                "then": {
                  "properties": {
                    "unknown_reasons": {
                      "required": [
                        "tolerances"
                      ]
                    }
                  }
                }
              }
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "schema_version",
        "cases"
      ],
      "additionalProperties": false
    }
  }
}
