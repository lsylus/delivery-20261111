{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satellite-drawings.invalid/contracts/mesh-map.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "model_ref": {
      "$ref": "common.schema.json#/$defs/ModelRef"
    },
    "units": {
      "const": "mm"
    },
    "coordinate_system": {
      "type": "string",
      "minLength": 1
    },
    "glb_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tolerance_mm": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "angular_tolerance_rad": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "faces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "node": {
            "type": "integer",
            "minimum": 0
          },
          "mesh": {
            "type": "integer",
            "minimum": 0
          },
          "primitive": {
            "type": "integer",
            "minimum": 0
          },
          "triangle_start": {
            "type": "integer",
            "minimum": 0
          },
          "triangle_count": {
            "type": "integer",
            "minimum": 1
          },
          "face_ref": {
            "$ref": "#/$defs/FaceRef"
          }
        },
        "required": [
          "node",
          "mesh",
          "primitive",
          "triangle_start",
          "triangle_count",
          "face_ref"
        ],
        "additionalProperties": false
      }
    },
    "unrenderable_faces": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "face_ref": {
            "$ref": "#/$defs/FaceRef"
          },
          "diagnostic": {
            "type": "object"
          }
        },
        "required": [
          "face_ref",
          "diagnostic"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "model_ref",
    "units",
    "coordinate_system",
    "glb_sha256",
    "tolerance_mm",
    "angular_tolerance_rad",
    "faces"
  ],
  "additionalProperties": false,
  "$defs": {
    "FaceRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/EntityRef"
        },
        {
          "properties": {
            "entity_kind": {
              "const": "face"
            }
          }
        }
      ]
    }
  }
}
