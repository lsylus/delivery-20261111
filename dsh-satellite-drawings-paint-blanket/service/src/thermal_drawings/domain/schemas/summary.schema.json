{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://satellite-drawings.invalid/contracts/summary.schema.json",
  "$ref": "#/$defs/Summary",
  "$defs": {
    "Summary": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "batch_id": {
          "type": "string",
          "pattern": "^B[0-9]{2}$"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        },
        "code_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "dirty": {
          "type": "boolean"
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "argv": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "exit_code": {
                "type": "integer"
              },
              "log_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "argv",
              "exit_code",
              "log_ref"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "tests": {
          "type": "object",
          "properties": {
            "required": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "skipped_required": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "required",
            "passed",
            "failed",
            "skipped_required"
          ],
          "additionalProperties": false
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "pass",
                  "fail",
                  "blocked"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "status",
              "reason"
            ],
            "additionalProperties": false
          },
          "minItems": 0
        },
        "manual_evidence": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "minItems": 0
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "resources_created": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "resources_cleaned": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "batch_id",
        "status",
        "code_revision",
        "dirty",
        "prerequisites",
        "commands",
        "tests",
        "inputs",
        "artifacts",
        "checks",
        "manual_evidence",
        "limitations",
        "resources_created",
        "resources_cleaned"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "passed"
              }
            }
          },
          "then": {
            "properties": {
              "tests": {
                "properties": {
                  "passed": {
                    "minimum": 1
                  },
                  "failed": {
                    "const": 0
                  },
                  "skipped_required": {
                    "const": 0
                  }
                }
              },
              "checks": {
                "items": {
                  "properties": {
                    "status": {
                      "const": "pass"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
