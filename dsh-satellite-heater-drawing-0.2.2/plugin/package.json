{
  "name": "@qmh/dsh-satellite-heater-drawing",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "矩形加热器 Excel 批量 DWG/PDF 出图工作台",
  "engines": {
    "node": "^22.19.0 || >=24",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "public",
    "runtime",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "node check-package.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "pdfjs-dist": "6.5.438",
    "react": "19.2.0"
  }
}
